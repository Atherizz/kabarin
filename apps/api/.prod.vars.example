# Cloudflare Workers Production Environment Variables & Secrets Example
ENVIRONMENT="production"
NODE_ENV="production"
BETTER_AUTH_URL="https://kabarin-api.atherizz.dev"
TRUSTED_ORIGINS="https://kabarin.atherizz.dev,https://kabarin-api.atherizz.dev"

DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
BETTER_AUTH_SECRET="your-better-auth-secret-min-32-chars"

R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="kabarin-storage"
R2_PUBLIC_URL="https://cdn.kabarin.atherizz.dev"

AZURE_OPENAI_API_KEY="your-azure-openai-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/openai/v1/"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5.4-mini"

BOT_WEBHOOK_URL="https://bot.kabarin.atherizz.dev"
WEBHOOK_SECRET="your-strong-webhook-secret"
