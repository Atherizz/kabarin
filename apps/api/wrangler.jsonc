{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kabarin-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://kabarin-api.atherizz.dev",
    "TRUSTED_ORIGINS": "http://localhost:5173,http://localhost:4321,http://localhost:8787,https://kabarin.pages.dev,https://kabarin.atherizz.dev,https://kabarin-api.atherizz.dev"
  },
  "observability": {
    "enabled": true
  }
}
