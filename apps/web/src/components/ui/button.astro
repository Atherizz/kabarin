---
interface Props {
  href: string;
  title: string;
  description: string;
  variant: 'brand' | 'accent';
}

const { href, title, description, variant = 'brand' } = Astro.props;

const colorVariants = {
  brand: {
    card: "bg-brand/25",
    circle: "bg-brand/25",
    largeIcon: "text-brand/25"
  },
  accent: {
    card: "bg-accent/25",
    circle: "bg-accent/25",
    largeIcon: "text-accent/25"
  }
};

const activeColors = colorVariants[variant];
---

<a
  href={href}
  class={`relative flex flex-col justify-between w-full max-w-70 min-h-60 md:min-h-95 p-5 pb-8 md:p-8 md:pb-12 overflow-hidden text-left transition-transform duration-200 rounded-[45px] md:rounded-[75px] hover:-translate-y-1 ${activeColors.card}`}
>
  <!-- Small icon -->
  <div class="relative w-full h-20 md:h-25">
    <div class={`relative z-10 flex items-center justify-center size-14 md:size-20 rounded-full text-dark [&>svg]:size-6 md:[&>svg]:size-9 [&>svg]:fill-current ${activeColors.circle}`}>
      <slot name="small-icon" />
    </div>
    
    <!-- Large icon -->
    <div class={`absolute -top-10 -right-21 md:-top-15 md:-right-25 z-0 pointer-events-none [&>svg]:size-40 md:[&>svg]:size-55 [&>svg]:fill-current ${activeColors.largeIcon}`}>
      <slot name="large-icon" />
    </div>
  </div>

  <!-- Button contents -->
  <div class="relative z-10 mt-6 md:mt-8">
    <h3 class="text-xl md:text-[1.75rem] font-semibold tracking-[-0.04em] text-dark mb-0.5">
      {title}
    </h3>
    <p class="text-[12.5px] md:text-lg font-medium leading-tight text-dark/80">
      {description}
    </p>
  </div>
</a>
