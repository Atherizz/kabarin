---
import { House, EnvelopeSimple, User } from 'phosphor-svelte';
---

<nav
  transition:persist="bottom-nav"
  class="h-full w-full bg-light-darker pb-safe border-t border-gray-200/50
         md:border-t-0 md:border-r md:pb-0"
>
  <div class="flex h-full items-center justify-around px-6 pt-2 pb-4
              md:flex-col md:justify-start md:gap-2 md:p-4">

    <!-- Beranda -->
    <a href="/" class="nav-link flex transition-colors duration-300 flex-col items-center justify-center w-30 h-18 gap-1 rounded-4xl
                       md:justify-start md:w-full md:h-auto md:px-5 md:py-8 md:gap-2"
       data-href="/">
      <div class="relative flex items-center justify-center">
        <House weight="fill" class="size-9 icon" />
      </div>
      <span class="text-[13px] font-semibold tracking-tight md:text-[15px]">Beranda</span>
    </a>

    <!-- Pesan -->
    <a href="/pesan" class="nav-link flex transition-colors duration-300 flex-col items-center justify-center w-30 h-18 gap-1 rounded-4xl
                            md:justify-start md:w-full md:h-auto md:px-5 md:py-8 md:gap-2"
       data-href="/pesan">
      <div class="relative flex items-center justify-center">
        <EnvelopeSimple weight="fill" class="size-9 icon" />

        <!-- Notification Badge -->
        <span class="absolute -top-1.5 -right-2.5 flex items-center italic justify-center h-5 px-1.5 min-w-5 text-[11px] font-bold text-white bg-brand rounded-full border-[2.5px] border-light-darker
                     md:-top-1 md:-right-2">
          10
        </span>
      </div>
      <span class="text-[13px] font-semibold tracking-tight md:text-[15px]">Pesan</span>
    </a>

    <!-- Profil -->
    <a href="/profil" class="nav-link flex transition-colors duration-300 flex-col items-center justify-center w-30 h-18 gap-1 rounded-4xl
                             md:justify-start md:w-full md:h-auto md:px-5 md:py-8 md:gap-2"
       data-href="/profil">
      <div class="relative flex items-center justify-center">
        <User weight="fill" class="size-9 icon" />
      </div>
      <span class="text-[13px] font-semibold tracking-tight md:text-[15px]">Profil</span>
    </a>

  </div>
</nav>

<script>
  function updateNav() {
    const currentPath = window.location.pathname;
    const links = document.querySelectorAll<HTMLAnchorElement>('.nav-link');

    links.forEach((link) => {
      const href = link.dataset.href ?? '/';
      const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));

      if (isActive) {
        link.classList.add('bg-brand/25', 'text-brand');
        link.classList.remove('text-dark/75');
      } else {
        link.classList.remove('bg-brand/25', 'text-brand');
        link.classList.add('text-dark/75');
      }
    });
  }

  document.addEventListener('astro:page-load', updateNav);
</script>

<style>
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom);
  }
</style>
