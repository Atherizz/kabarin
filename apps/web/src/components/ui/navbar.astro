---
import { House, EnvelopeSimple, User, SignOut, ClipboardText, HandsClapping } from 'phosphor-svelte';

interface Props {
  role?: "admin" | "cadre" | "volunteer" | "family";
}

const { role } = Astro.props;

const navItemsByRole = {
  cadre: [
    { href: "/dashboard", label: "Beranda", icon: House },
    { href: "/elderly", label: "Lansia", icon: EnvelopeSimple },
    { href: "/volunteers", label: "Relawan", icon: HandsClapping },
    { href: "/profil", label: "Profil", icon: User },
  ],
  admin: [
    { href: "/dashboard", label: "Beranda", icon: House },
    { href: "/elderly", label: "Lansia", icon: EnvelopeSimple },
    { href: "/volunteers", label: "Relawan", icon: HandsClapping },
    { href: "/profil", label: "Profil", icon: User },
  ],
  volunteer: [
    { href: "/volunteer/dashboard", label: "Beranda", icon: House },
    { href: "/volunteer/visits", label: "Tugas", icon: ClipboardText },
    { href: "/profil", label: "Profil", icon: User },
  ],
  family: [
    { href: "/family/dashboard", label: "Beranda", icon: House },
    { href: "/profil", label: "Profil", icon: User },
  ],
};

const navItems = navItemsByRole[role ?? "cadre"];
---

<nav
  transition:persist="bottom-nav"
  class="h-full w-full bg-light-darker pb-safe"
>
  <div class="flex h-full items-center justify-around px-6 pt-2 pb-5 text-dark/75
              md:flex-col md:justify-start md:gap-2 md:p-4 md:pt-5">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="nav-link relative flex transition-colors duration-300 flex-col items-center justify-center w-30 h-18 gap-1 rounded-4xl
               md:flex-row md:justify-start md:w-full md:h-auto md:px-5 md:py-6 md:gap-3 md:pr-12
               hover:bg-dark/7"
        data-href={item.href}
      >
        <div class="relative flex items-center justify-center">
          <item.icon weight="fill" class="size-9 icon md:size-7" />
        </div>
        <span class="text-[13px] font-semibold tracking-tight md:text-[18px]">{item.label}</span>
        <div class="overlay absolute inset-0 rounded-4xl transition-color duration-300"></div>
      </a>
    ))}

    <button
      id="logout-btn"
      type="button"
      class="nav-link relative flex transition-colors duration-300 flex-col items-center justify-center w-30 h-18 gap-1 rounded-4xl
             md:flex-row md:justify-start md:w-full md:h-auto md:px-5 md:py-6 md:gap-3 md:pr-12
             hover:bg-dark/7"
    >
      <div class="relative flex items-center justify-center">
        <SignOut weight="fill" class="size-9 icon md:size-7" />
      </div>
      <span class="text-[13px] font-semibold tracking-tight md:text-[18px]">Keluar</span>
      <div class="overlay absolute inset-0 rounded-4xl transition-color duration-300"></div>
    </button>
  </div>
</nav>
<script>
  function updateNav() {
    const currentPath = window.location.pathname;
    const links = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
    links.forEach((link) => {
      const href = link.dataset.href ?? '/';
      const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
      const overlay = link.querySelector('.overlay');
      if (isActive) {
        link.classList.add('text-brand');
        if (overlay) overlay.classList.add('bg-brand/25');
      } else {
        link.classList.remove('text-brand');
        if (overlay) overlay.classList.remove('bg-brand/25');
      }
    });
  }

  function bindLogout() {
    const btn = document.getElementById('logout-btn');
    if (!btn) return;

    if (btn.dataset.bound === 'true') return;
    btn.dataset.bound = 'true';

    btn.addEventListener('click', async () => {
      if (btn.hasAttribute('disabled')) return;
      btn.setAttribute('disabled', 'true');

      const apiBase = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8787';

      try {
        const res = await fetch(`${apiBase}/api/auth/sign-out`, {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({}),
        });
        console.log('Sign-out response:', res.status, await res.text());
      } catch (err) {
        console.error('Sign-out fetch failed:', err);
      } finally {
        document.cookie = 'better-auth.session_token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax;';
        window.location.href = '/login';
      }
    });
  }

  document.addEventListener('astro:page-load', () => {
    updateNav();
    bindLogout();
  });
</script>
<style>
  .pb-safe {
    padding-bottom: env(safe-area-inset-bottom);
  }
</style>
