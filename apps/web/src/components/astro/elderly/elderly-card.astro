---
import { MapPin, PersonSimpleWalk, Wheelchair, House } from "phosphor-svelte";

interface Props {
  id: string;
  name: string;
  age: number;
  address: string;
  mobilityStatus: "independent" | "needs_assistance" | "homebound";
  currentStatus: "green" | "yellow" | "red" | "grey";
  verificationStatus: "verified" | "pending_verification" | "rejected";
}

const { id, name, age, address, mobilityStatus, currentStatus, verificationStatus } = Astro.props;

const statusDot = {
  green: "bg-green-500",
  yellow: "bg-yellow-500",
  red: "bg-red-500",
  grey: "bg-dark/25",
};

const statusText = {
  green: "text-green-600",
  yellow: "text-yellow-600",
  red: "text-red-600",
  grey: "text-dark/40",
};

const statusBadgeBg = {
  green: "bg-green-500/10",
  yellow: "bg-yellow-500/10",
  red: "bg-red-500/10",
  grey: "bg-dark/5",
};

const statusLabel = {
  green: "Aman",
  yellow: "Perhatian",
  red: "Darurat",
  grey: "Belum Terjadwal",
};

const mobilityIcon = {
  independent: PersonSimpleWalk,
  needs_assistance: Wheelchair,
  homebound: House,
};

const MobilityIcon = mobilityIcon[mobilityStatus];
---

<a
  href={`/elderly/${id}`}
  class="flex items-center gap-5 rounded-[28px] bg-light-darker px-6 py-5 transition-transform duration-200 hover:-translate-y-0.5"
>
  <span class={`size-3.5 shrink-0 rounded-full ${statusDot[currentStatus]}`}></span>

  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2.5">
      <p class="font-semibold text-[18px] truncate">{name}</p>
      <span class="text-[14px] text-dark/40 shrink-0">{age} th</span>
      {verificationStatus === "pending_verification" && (
        <span class="text-[13px] font-medium text-accent shrink-0">Menunggu Verifikasi</span>
      )}
    </div>
    <div class="flex items-center gap-2 mt-1 text-dark/50">
      <MapPin weight="fill" class="size-4.5 shrink-0" />
      <p class="text-[15px] truncate">{address}</p>
    </div>
  </div>

  <div class={`flex items-center gap-1.5 shrink-0 rounded-full px-3.5 py-1.5 ${statusText[currentStatus]} ${statusBadgeBg[currentStatus]}`}>
    <MobilityIcon weight="fill" class="size-5.5" />
    <span class="text-[13px] font-semibold">
      {statusLabel[currentStatus]}
    </span>
  </div>
</a>