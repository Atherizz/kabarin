---
import { Clock, CheckCircle } from "phosphor-svelte";

interface Props {
  id: string;
  elderlyId: string;
  elderlyName?: string;
  tier: number;
  status: "open" | "resolved";
  reason?: string | null;
  createdAt: string;
  resolvedAt?: string | null;
}

const { elderlyId, elderlyName, tier, status, reason, createdAt, resolvedAt } = Astro.props;

const tierLabel = {
  1: "Tier 1 · Verifikasi Relawan",
  2: "Tier 2 · Alert Keluarga & RT",
  3: "Tier 3 · Rujukan Faskes",
};

const formattedDate = new Date(createdAt).toLocaleString("id-ID", {
  day: "numeric",
  month: "short",
  hour: "2-digit",
  minute: "2-digit",
});
---

<a
  href={`/elderly/${elderlyId}`}
  class={`flex flex-col gap-2 rounded-[28px] px-6 py-5 transition-transform duration-200 hover:-translate-y-0.5 ${
    status === "open" ? "bg-red-500/5" : "bg-light-darker"
  }`}
>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      {status === "open" ? (
        <Clock weight="fill" class="size-5 text-red-500" />
      ) : (
        <CheckCircle weight="fill" class="size-5 text-green-500" />
      )}
      <p class="font-semibold text-[17px] text-dark">{elderlyName ?? "Lansia"}</p>
    </div>
    <span class="text-[13px] text-dark/40">{formattedDate}</span>
  </div>

  <p class="text-[14px] font-medium text-dark/60">{tierLabel[tier as 1 | 2 | 3] ?? `Tier ${tier}`}</p>

  {reason && <p class="text-[14px] text-dark/50">{reason}</p>}

  <span class={`self-start rounded-full px-3.5 py-1.5 text-[13px] font-semibold mt-1 ${
    status === "open" ? "text-red-600 bg-red-500/10" : "text-green-600 bg-green-500/10"
  }`}>
    {status === "open" ? "Aktif" : "Selesai"}
  </span>
</a>