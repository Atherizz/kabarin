---
import "../../styles/global.css";
import { apiFetchPublic } from "../../lib/api-fetch-public";
import { Phone, Pill, MapPin, Ambulance, Stethoscope, UserCircle } from "phosphor-svelte";

export const prerender = false;

const { token } = Astro.params;

interface FamilyStatusData {
  elderly: {
    name: string;
    age: number;
    currentStatus: "green" | "yellow" | "red" | "grey";
    mobilityStatus: string;
    rt: string;
    rw: string;
    preferredCheckinTime: string;
    updatedAt: string;
  };
  familyMember: { name: string; relationship: string };
  community: {
    name: string;
    healthFacilityName: string | null;
    healthFacilityPhone: string | null;
    ambulancePhone: string | null;
  };
  medications: {
    id: string;
    conditionName: string;
    medicationName: string;
    dosage: string;
    frequency: string;
    reminderTime: string;
    timingInstruction: string;
    isActive: boolean;
  }[];
  assignedVolunteer: { name: string; phone: string } | null;
}

const response = await apiFetchPublic<FamilyStatusData>(`/api/family/status/${token}`);
const data = response?.success ? response.data : null;

const statusConfig = {
  green: { label: "Aman Terverifikasi", text: "text-emerald-400", bg: "bg-emerald-500/10", border: "border-emerald-500/20", dot: "bg-emerald-400" },
  yellow: { label: "Butuh Perhatian", text: "text-amber-400", bg: "bg-amber-500/10", border: "border-amber-500/20", dot: "bg-amber-400" },
  red: { label: "Eskalasi Darurat", text: "text-rose-500", bg: "bg-rose-500/10", border: "border-rose-500/20", dot: "bg-rose-500" },
  grey: { label: "Belum Terjadwal", text: "text-[#a1a1aa]", bg: "bg-white/5", border: "border-white/10", dot: "bg-[#52525b]" },
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Status Pemantauan - Kabarin</title>
  </head>
  <body class="bg-[#0a0a0a] text-[#f4f3ee] min-h-dvh antialiased selection:bg-[#f4f3ee] selection:text-[#0a0a0a]">
    <div class="max-w-lg mx-auto px-6 py-12 flex flex-col gap-8">
      
      {#if data}
        {@const status = statusConfig[data.elderly.currentStatus]}
        
        <header class="text-center space-y-1 mt-4">
          <p class="text-[14px] font-medium text-[#a1a1aa]">Halo, {data.familyMember.name}</p>
          <h1 class="text-[28px] font-semibold tracking-tight text-white">{data.elderly.name}</h1>
          <p class="text-[#a1a1aa] text-[15px]">
            Usia {data.elderly.age} th · RT {data.elderly.rt}/RW {data.elderly.rw}
          </p>
        </header>

        <!-- Status Card -->
        <section class={`rounded-[32px] p-8 flex flex-col items-center gap-3 border ${status.bg} ${status.border} backdrop-blur-xl relative overflow-hidden`}>
          <div class="flex items-center justify-center w-12 h-12 rounded-full bg-black/40 border border-white/5 mb-2">
            <span class={`w-4 h-4 rounded-full ${status.dot} shadow-[0_0_12px_currentColor]`}></span>
          </div>
          <p class={`text-[15px] font-medium ${status.text}`}>Status Hari Ini</p>
          <p class={`text-[32px] font-bold tracking-tight ${status.text}`}>
            {status.label}
          </p>
          <p class="text-[13px] text-[#a1a1aa] mt-2">
            Diperbarui {new Date(data.elderly.updatedAt).toLocaleString("id-ID", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" })} WIB
          </p>
        </section>

        <!-- Relawan Pendamping -->
        <section class="rounded-[28px] bg-white/[0.03] border border-white/5 p-6 flex items-center gap-5">
          <div class="flex items-center justify-center w-14 h-14 rounded-[20px] bg-white/5 border border-white/5 shrink-0">
            <UserCircle weight="fill" class="size-7 text-[#a1a1aa]" />
          </div>
          <div>
            <p class="text-[14px] font-medium text-[#a1a1aa] mb-1">Relawan Pendamping</p>
            {#if data.assignedVolunteer}
              <p class="text-[17px] font-semibold text-white">{data.assignedVolunteer.name}</p>
              <p class="text-[14px] text-[#a1a1aa] mt-0.5">{data.assignedVolunteer.phone}</p>
            {:else}
              <p class="text-[15px] italic text-[#a1a1aa]">Belum ditugaskan</p>
            {/if}
          </div>
        </section>

        <!-- Jadwal Obat -->
        {#if data.medications.length > 0}
          <section class="flex flex-col gap-4 mt-2">
            <div class="flex items-center gap-2.5 px-2">
              <Pill weight="fill" class="size-5 text-[#f4f3ee]" />
              <h2 class="text-[18px] font-semibold text-white">Jadwal Obat Harian</h2>
            </div>
            
            <div class="flex flex-col gap-3">
              {#each data.medications as med}
                <div class="rounded-[24px] bg-white/[0.03] border border-white/5 p-5 flex items-center justify-between">
                  <div>
                    <p class="text-[16px] font-medium text-white">{med.medicationName}</p>
                    <p class="text-[13px] text-[#a1a1aa] mt-1">{med.dosage} · {med.timingInstruction}</p>
                  </div>
                  <span class="rounded-full bg-white/10 px-3 py-1 text-[14px] font-medium text-white">
                    {med.reminderTime}
                  </span>
                </div>
              {/each}
            </div>
          </section>
        {/if}

        <!-- Kontak Darurat Faskes -->
        {#if data.community.healthFacilityPhone || data.community.ambulancePhone}
          <section class="rounded-[28px] bg-rose-500/5 border border-rose-500/10 p-6 flex flex-col gap-4 mt-2">
            <div class="flex items-center gap-2.5">
              <Ambulance weight="fill" class="size-5 text-rose-500" />
              <p class="text-[16px] font-semibold text-rose-500">Kontak Darurat Wilayah</p>
            </div>
            
            <div class="space-y-3">
              {#if data.community.healthFacilityName}
                <div class="flex items-center justify-between border-b border-rose-500/10 pb-3">
                  <span class="text-[14px] text-[#a1a1aa]">{data.community.healthFacilityName}</span>
                  <span class="text-[15px] font-medium text-white">{data.community.healthFacilityPhone}</span>
                </div>
              {/if}
              {#if data.community.ambulancePhone}
                <div class="flex items-center justify-between">
                  <span class="text-[14px] text-[#a1a1aa]">Ambulans Siaga</span>
                  <span class="text-[15px] font-medium text-white">{data.community.ambulancePhone}</span>
                </div>
              {/if}
            </div>
          </section>
        {/if}

      {#else}
        <!-- Error State -->
        <div class="rounded-[32px] bg-rose-500/10 border border-rose-500/20 p-10 text-center mt-12 flex flex-col items-center gap-4">
          <div class="w-16 h-16 rounded-full bg-rose-500/20 flex items-center justify-center">
            <span class="text-2xl">⚠️</span>
          </div>
          <div>
            <p class="text-[20px] font-semibold text-rose-500">Tautan Tidak Valid</p>
            <p class="text-[15px] text-[#a1a1aa] mt-2 leading-relaxed">
              Tautan pemantauan ini mungkin sudah kedaluwarsa atau akses telah dicabut. Silakan hubungi Kader RT setempat.
            </p>
          </div>
        </div>
      {/if}

    </div>
  </body>
</html>