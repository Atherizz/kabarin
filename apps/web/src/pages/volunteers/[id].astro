---
import Layout from "../../layouts/layout.astro";
import { apiFetch } from "../../lib/api-fetch";
import type { Volunteer } from "@kabarin/types";
import { ArrowLeft, Phone, MapPin } from "phosphor-svelte";

const { id } = Astro.params;

const volunteer = await apiFetch<Volunteer & { assignedElderly?: { elderly: any }[] }>(
  Astro.request,
  `/api/volunteers/${id}`
);

if (!volunteer) {
  return Astro.redirect("/volunteers");
}
---

<Layout title={volunteer.name} description={`Profil relawan ${volunteer.name}`}>
  <div class="flex flex-col gap-8 max-w-2xl">
    <a href="/volunteers" class="self-end flex items-center gap-2 text-brand text-[15px] font-medium">
      <ArrowLeft weight="bold" class="size-5" />
      <span>Kembali ke direktori</span>
    </a>

    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-[32px] font-semibold tracking-[-0.03em] text-dark">{volunteer.name}</h1>
        <p class="text-dark/50 text-[16px] mt-1">
          {volunteer.assignedElderlyCount}/{volunteer.maxCapacity} binaan
        </p>
      </div>
      <span class={`rounded-full flex justify-center items-center px-5 py-2.5 text-[15px] font-semibold ${
        volunteer.isActive ? "text-green-600 bg-green-500/10" : "text-dark/40 bg-dark/5"
      }`}>
        {volunteer.isActive ? "Aktif" : "Non-aktif"}
      </span>
    </div>

    <section class="rounded-[28px] bg-light-darker p-6 flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <Phone weight="fill" class="size-5 text-dark/40 shrink-0" />
        <p class="text-[16px] text-dark">{volunteer.phone}</p>
      </div>
      <div class="flex items-start gap-3">
        <MapPin weight="fill" class="size-5 text-dark/40 mt-0.5 shrink-0" />
        <div>
          <p class="text-[16px] text-dark">{volunteer.address}</p>
          <p class="text-[14px] text-dark/50 mt-0.5">RT {volunteer.rt} / RW {volunteer.rw}</p>
        </div>
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <h2 class="text-[20px] font-semibold text-dark">Lansia Binaan</h2>

      {volunteer.assignedElderly && volunteer.assignedElderly.length > 0 ? (
        <div class="flex flex-col gap-3">
          {volunteer.assignedElderly.map((assignment) => (
            <a
              href={`/elderly/${assignment.elderly.id}`}
              class="rounded-3xl bg-light-darker px-6 py-4 flex items-center justify-between hover:bg-light-darker/70 transition-colors"
            >
              <p class="font-semibold text-[16px] text-dark">{assignment.elderly.name}</p>
              <p class="text-[14px] text-dark/50">{assignment.elderly.address}</p>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-dark/40 text-[15px]">Belum ada lansia binaan.</p>
      )}
    </section>
  </div>
</Layout>