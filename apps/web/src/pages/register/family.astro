---
import Layout from "../../layouts/layout.astro";
import FamilyRegisterForm from "../../components/svelte/family-register-form.svelte";
---

<Layout title="Daftar sebagai Keluarga" description="Buat akun untuk memantau orang tua Anda." noindex>
  <div class="flex flex-col gap-8 max-w-lg mx-auto py-10">
    <div>
      <h1 class="text-[32px] font-semibold tracking-[-0.03em] text-dark">Daftar sebagai Keluarga</h1>
      <p class="text-dark/50 text-[16px] mt-1">
        Buat akun untuk mendaftarkan dan memantau kondisi orang tua Anda.
      </p>
    </div>

    <FamilyRegisterForm client:load />

    <p class="text-center text-[15px] text-dark/50">
      Sudah punya akun? <a href="/login" class="text-brand font-medium">Masuk di sini</a>
    </p>
  </div>
</Layout>