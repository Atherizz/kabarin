---
const { user } = Astro.locals;

switch (user?.role) {
  case "cadre":
  case "admin":
    return Astro.redirect("/dashboard");
  case "volunteer":
    return Astro.redirect("/volunteer/dashboard");
  case "family":
    return Astro.redirect("/family/dashboard");
  default:
    return Astro.redirect("/login");
}
