---
import Layout from "../../layouts/layout.astro";
import ElderlyOnboardingForm from "../../components/svelte/elderly-form.svelte";
import { apiFetch } from "../../lib/api-fetch";
import { ArrowLeft } from "phosphor-svelte";

interface VolunteerOption {
  id: string;
  name: string;
  address: string;
  maxCapacity: number;
  assignedElderlyCount: number;
  isActive: boolean;
}

const allVolunteers = (await apiFetch<VolunteerOption[]>(Astro.request, "/api/volunteers")) ?? [];
const volunteers = allVolunteers.filter((v) => v.isActive);
---

<Layout title="Daftarkan Lansia" description="Form pendaftaran lansia baru.">
  <div class="flex flex-col gap-8 max-w-2xl">
    <a href="/elderly" class="self-end flex items-center gap-2 text-brand text-[15px] font-medium">
      <ArrowLeft weight="bold" class="size-5" />
      <span>Kembali ke direktori</span>
    </a>

    <h1 class="text-[32px] font-semibold tracking-[-0.03em] text-dark">Daftarkan Lansia Baru</h1>

    <ElderlyOnboardingForm client:load volunteers={volunteers} />
  </div>
</Layout>