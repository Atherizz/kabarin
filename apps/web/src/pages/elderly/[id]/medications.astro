---
import Layout from "../../../layouts/layout.astro";
import MedicationManager from "../../../components/svelte/medication-manager.svelte";
import { apiFetch } from "../../../lib/api-fetch";
import type { Elderly } from "@kabarin/types";
import { ArrowLeft } from "phosphor-svelte";

const { id } = Astro.params;

// Fetch the elderly profile to get their name and existing medications
const elderlyData = await apiFetch<Elderly>(Astro.request, `/api/elderly/${id}`);

if (!elderlyData) {
  return Astro.redirect("/elderly");
}

const medications = elderlyData.medications || [];
---

<Layout title={`Kelola Obat - ${elderlyData.name}`} description={`Pindai dan kelola resep obat untuk ${elderlyData.name}`}>
  <div class="flex flex-col gap-8 max-w-2xl">
    <a href={`/elderly/${id}`} class="self-end flex items-center gap-2 text-brand text-[15px] font-medium hover:opacity-80 transition-opacity">
      <ArrowLeft weight="bold" class="size-5" />
      <span>Kembali ke profil</span>
    </a>

    <div>
      <h1 class="text-[32px] font-semibold tracking-[-0.03em] text-dark">Kelola Obat & Resep</h1>
      <p class="text-[15px] text-dark/50 mt-1">
        Pindai resep otomatis dengan AI atau input manual untuk <strong>{elderlyData.name}</strong>.
      </p>
    </div>

    <MedicationManager client:load elderlyId={id} initialMedications={medications} />
  </div>
</Layout>