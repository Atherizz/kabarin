---
import Layout from "../../../layouts/layout.astro";
import StatusBadge from "../../../components/astro/elderly/status-badge.astro";
import RiskScoreCard from "../../../components/svelte/risk-score-card.svelte";
import { apiFetch } from "../../../lib/api-fetch";
import type { Elderly, EscalationLog, CheckinSession } from "@kabarin/types";
import { ArrowLeft, MapPin, Phone, Pill, Users, Clock, ChartLineUp, PencilSimple } from "phosphor-svelte";
const { id } = Astro.params;

interface RiskScoreResponse {
  elderlyId: string;
  elderlyName: string;
  totalScore: number;
  category: "rendah" | "sedang" | "tinggi";
  breakdown: Record<string, { score: number; note: string }>;
  xaiNarrative: string | null;
  computedAt: string;
}

const [elderlyData, escalations, checkins, riskScore] = await Promise.all([
  apiFetch<Elderly>(Astro.request, `/api/elderly/${id}`),
  apiFetch<EscalationLog[]>(Astro.request, `/api/escalations?elderlyId=${id}`),
  apiFetch<CheckinSession[]>(Astro.request, `/api/checkins/${id}?limit=10`),
  apiFetch<RiskScoreResponse>(Astro.request, `/api/elderly/${id}/risk-score`),
]);

if (!elderlyData) {
  return Astro.redirect("/elderly");
}

const mobilityLabel = {
  independent: "Mandiri",
  needs_assistance: "Butuh Bantuan",
  homebound: "Homebound",
};

const monitoringLabel = {
  active: "Aktif (WhatsApp)",
  passive: "Pasif (Family Proxy)",
};
---

<Layout title={elderlyData.name} description={`Profil lansia ${elderlyData.name}`}>
  <div class="flex flex-col gap-8 max-w-2xl">
    
    <!-- Top Navigation Actions -->
    <div class="flex items-center justify-between">
      <a href="/elderly" class="flex items-center gap-2 text-brand text-[15px] font-medium hover:opacity-80 transition-opacity">
        <ArrowLeft weight="bold" class="size-5" />
        <span>Kembali ke direktori</span>
      </a>
      
      <a 
        href={`/elderly/${id}/edit`} 
        class="flex items-center gap-1.5 rounded-full bg-brand/10 px-4 py-2 text-[14px] font-semibold text-brand hover:bg-brand/20 transition-colors"
      >
        <PencilSimple weight="bold" class="size-4" />
        Edit Profil
      </a>
    </div>

    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-[32px] font-semibold tracking-[-0.03em] text-dark">{elderlyData.name}</h1>
        <p class="text-dark/50 text-[16px] mt-1">{elderlyData.age} tahun · {elderlyData.gender === "female" ? "Perempuan" : "Laki-laki"}</p>
      </div>
      <StatusBadge status={elderlyData.currentStatus} />
    </div>

    <!-- Identitas -->
    <section class="rounded-[28px] bg-light-darker p-6 flex flex-col gap-4">
      <div class="flex items-start gap-3">
        <MapPin weight="fill" class="size-5 text-dark/40 mt-0.5 shrink-0" />
        <div>
          <p class="text-[16px] text-dark">{elderlyData.address}</p>
          <p class="text-[14px] text-dark/50 mt-0.5">RT {elderlyData.rt} / RW {elderlyData.rw}</p>
        </div>
      </div>

      {elderlyData.phone && (
        <div class="flex items-center gap-3">
          <Phone weight="fill" class="size-5 text-dark/40 shrink-0" />
          <p class="text-[16px] text-dark">{elderlyData.phone}</p>
        </div>
      )}

      <div class="flex flex-wrap gap-2 pt-2">
        <span class="rounded-full bg-light px-4 py-2 text-[13px] font-medium text-dark/60">
          {mobilityLabel[elderlyData.mobilityStatus]}
        </span>
        <span class="rounded-full bg-light px-4 py-2 text-[13px] font-medium text-dark/60">
          {monitoringLabel[elderlyData.monitoringMode]}
        </span>
        <span class="rounded-full bg-light px-4 py-2 text-[13px] font-medium text-dark/60">
          Sapaan {elderlyData.preferredCheckinTime}
        </span>
      </div>

      {elderlyData.medicalHistory && (
        <div class="pt-2 border-t border-dark/10">
          <p class="text-[14px] text-dark/50 mb-1">Riwayat Medis</p>
          <p class="text-[16px] text-dark">{elderlyData.medicalHistory}</p>
        </div>
      )}
    </section>

    <!-- Analisis Risiko -->
    {riskScore && (
      <section class="flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <ChartLineUp weight="fill" class="size-5 text-brand" />
          <h2 class="text-[20px] font-semibold text-dark">Analisis Risiko</h2>
        </div>
        
        <RiskScoreCard data={riskScore} client:visible />
      </section>
    )}

    <!-- Obat -->
    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-2.5">
        <Pill weight="fill" class="size-5 text-brand" />
        <h2 class="text-[20px] font-semibold text-dark">Jadwal Obat</h2>
      </div>

      {elderlyData.medications && elderlyData.medications.length > 0 ? (
        <div class="flex flex-col gap-3">
          {elderlyData.medications.map((med) => (
            <div class="rounded-3xl bg-light-darker px-6 py-4 flex items-center justify-between">
              <div>
                <p class="font-semibold text-[16px] text-dark">{med.medicationName}</p>
                <p class="text-[14px] text-dark/50 mt-0.5">{med.dosage} · {med.frequency}</p>
              </div>
              <span class="text-[15px] font-medium text-brand">{med.reminderTime}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-dark/40 text-[15px]">Belum ada jadwal obat tercatat.</p>
      )}
    </section>

    <!-- Keluarga -->
    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-2.5">
        <Users weight="fill" class="size-5 text-brand" />
        <h2 class="text-[20px] font-semibold text-dark">Kontak Keluarga</h2>
      </div>

      {elderlyData.familyMembers && elderlyData.familyMembers.length > 0 ? (
        <div class="flex flex-col gap-3">
          {elderlyData.familyMembers.map((member) => (
            <div class="rounded-3xl bg-light-darker px-6 py-4 flex items-center justify-between">
              <div>
                <p class="font-semibold text-[16px] text-dark">
                  {member.name}
                  {member.isPrimaryContact && (
                    <span class="ml-2 text-[12px] font-medium text-brand">Utama</span>
                  )}
                </p>
                <p class="text-[14px] text-dark/50 mt-0.5">{member.relationship} · {member.phone}</p>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-dark/40 text-[15px]">Belum ada kontak keluarga tercatat.</p>
      )}
    </section>

    <!-- Riwayat Eskalasi -->
    {escalations && escalations.length > 0 && (
      <section class="flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <Clock weight="fill" class="size-5 text-red-500" />
          <h2 class="text-[20px] font-semibold text-dark">Riwayat Eskalasi</h2>
        </div>

        <div class="flex flex-col gap-3">
          {escalations.map((esc) => (
            <div class="rounded-3xl bg-red-500/5 px-6 py-4">
              <div class="flex items-center justify-between">
                <p class="font-semibold text-[15px] text-dark">Tier {esc.tier} · {esc.status === "open" ? "Aktif" : "Selesai"}</p>
                <p class="text-[13px] text-dark/40">{new Date(esc.createdAt).toLocaleDateString("id-ID")}</p>
              </div>
              {esc.reason && <p class="text-[14px] text-dark/60 mt-1">{esc.reason}</p>}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Riwayat Check-in -->
    {checkins && checkins.length > 0 && (
      <section class="flex flex-col gap-4">
        <h2 class="text-[20px] font-semibold text-dark">Riwayat Sapaan</h2>

        <div class="flex flex-col gap-2.5">
          {checkins.map((c) => (
            <div class="rounded-2xl bg-light-darker px-5 py-3.5 flex items-center justify-between">
              <p class="text-[14px] text-dark/70">{c.sessionDate}</p>
              <span class="text-[13px] font-medium text-dark/50 capitalize">{c.status}</span>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>