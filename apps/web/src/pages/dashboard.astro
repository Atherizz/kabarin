---
import Layout from "../layouts/layout.astro";
import Button from "../components/ui/button.astro";
import BriefingCard from "../components/astro/dashboard/briefing-card.astro";
import StatsRow from "../components/astro/dashboard/stats-row.astro";
import { apiFetch } from "../lib/api-fetch";
import type { BriefingResponse, DashboardStats } from "@kabarin/types";
import {
  Users,
  NotePencil,
  Scan,
  UsersThree,
  Warning,
} from "phosphor-svelte";

const [briefing, stats] = await Promise.all([
  apiFetch<BriefingResponse>(Astro.request, "/api/dashboard/briefing"),
  apiFetch<DashboardStats>(Astro.request, "/api/dashboard/stats"),
]);

const { user } = Astro.locals;
---

<Layout title="Dashboard" description="Ringkasan wilayah RT hari ini.">
  <div class="flex flex-col gap-7.5">
    <h1 class="leading-none text-4xl">
      <span class="font-medium opacity-75">Halo</span>
      <span class="font-semibold opacity-100">{user?.name ?? "Kader"}</span>
    </h1>

    <StatsRow stats={stats} />

    <BriefingCard briefing={briefing} />

    <div class="flex flex-wrap justify-center md:justify-start gap-1.25 md:gap-5">
      <Button
        href="/elderly"
        title="Direktori Lansia"
        description="Lihat dan kelola seluruh lansia binaan RT."
        variant="brand"
      >
        <Users slot="small-icon" weight="fill" />
        <Users slot="large-icon" weight="fill" />
      </Button>

      <Button
        href="/elderly/new"
        title="Daftarkan Lansia"
        description="Isi formulir pendaftaran lansia baru."
        variant="accent"
      >
        <NotePencil slot="small-icon" weight="fill" />
        <NotePencil slot="large-icon" weight="fill" />
      </Button>

      <Button
        href="/elderly/new?ocr=1"
        title="Pindai Resep Obat"
        description="Catat penjadwalan obat lansia lewat foto resep."
        variant="brand"
      >
        <Scan slot="small-icon" weight="fill" />
        <Scan slot="large-icon" weight="fill" />
      </Button>

      <Button
        href="/volunteers"
        title="Tugaskan Relawan"
        description="Kelola relawan dan bagikan penugasan binaan."
        variant="accent"
      >
        <UsersThree slot="small-icon" weight="fill" />
        <UsersThree slot="large-icon" weight="fill" />
      </Button>

      <Button
        href="/escalations"
        title="Log Eskalasi"
        description="Pantau insiden darurat aktif dan riwayatnya."
        variant="brand"
      >
        <Warning slot="small-icon" weight="fill" />
        <Warning slot="large-icon" weight="fill" />
      </Button>
    </div>
  </div>
</Layout>