---
import Layout from "../../../layouts/layout.astro";
import StatusBadge from "../../../components/astro/elderly/status-badge.astro";
import { apiFetch } from "../../../lib/api-fetch";
import { ArrowLeft, MapPin, Phone, Clock } from "phosphor-svelte";

const { id } = Astro.params;

interface VolunteerAssignmentsResponse {
  assignments: {
    elderly: {
      id: string;
      name: string;
      phone: string | null;
      age: number;
      gender: string;
      address: string;
      rt: string;
      rw: string;
      mobilityStatus: "independent" | "needs_assistance" | "homebound";
      currentStatus: "green" | "yellow" | "red" | "grey";
      preferredCheckinTime: string;
      medicalHistory: string | null;
      notes: string | null;
    };
  }[];
}

interface CheckinSession {
  id: string;
  sessionDate: string;
  status: string;
}

const [assignmentsData, checkins] = await Promise.all([
  apiFetch<VolunteerAssignmentsResponse>(Astro.request, "/api/volunteers/me/assignments"),
  apiFetch<CheckinSession[]>(Astro.request, `/api/elderly/${id}/checkins?limit=10`),
]);

const assignment = assignmentsData?.assignments.find((a) => a.elderly.id === id);

if (!assignment) {
  return Astro.redirect("/volunteer/dashboard");
}

const elderly = assignment.elderly;

const mobilityLabel = {
  independent: "Mandiri",
  needs_assistance: "Butuh Bantuan",
  homebound: "Homebound",
};
---

<Layout title={elderly.name} description={`Profil lansia binaan ${elderly.name}`}>
  <div class="flex flex-col gap-8 max-w-2xl">
    <a href="/volunteer/dashboard" class="self-end flex items-center gap-2 text-brand text-[15px] font-medium">
      <ArrowLeft weight="bold" class="size-5" />
      <span>Kembali ke dasbor</span>
    </a>

    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-[32px] font-semibold tracking-[-0.03em] text-dark">{elderly.name}</h1>
        <p class="text-dark/50 text-[16px] mt-1">
          {elderly.age} tahun · {elderly.gender === "female" ? "Perempuan" : "Laki-laki"}
        </p>
      </div>
      <StatusBadge status={elderly.currentStatus} />
    </div>

    <section class="rounded-[28px] bg-light-darker p-6 flex flex-col gap-4">
      <div class="flex items-start gap-3">
        <MapPin weight="fill" class="size-5 text-dark/40 mt-0.5 shrink-0" />
        <div>
          <p class="text-[16px] text-dark">{elderly.address}</p>
          <p class="text-[14px] text-dark/50 mt-0.5">RT {elderly.rt} / RW {elderly.rw}</p>
        </div>
      </div>

      {elderly.phone && (
        <div class="flex items-center gap-3">
          <Phone weight="fill" class="size-5 text-dark/40 shrink-0" />
          <p class="text-[16px] text-dark">{elderly.phone}</p>
        </div>
      )}

      <div class="flex flex-wrap gap-2 pt-2">
        <span class="rounded-full bg-light px-4 py-2 text-[13px] font-medium text-dark/60">
          {mobilityLabel[elderly.mobilityStatus]}
        </span>
        <span class="rounded-full bg-light px-4 py-2 text-[13px] font-medium text-dark/60">
          Sapaan {elderly.preferredCheckinTime}
        </span>
      </div>

      {elderly.medicalHistory && (
        <div class="pt-2 border-t border-dark/10">
          <p class="text-[14px] text-dark/50 mb-1">Riwayat Medis</p>
          <p class="text-[16px] text-dark">{elderly.medicalHistory}</p>
        </div>
      )}

      {elderly.notes && (
        <div class="pt-2 border-t border-dark/10">
          <p class="text-[14px] text-dark/50 mb-1">Catatan</p>
          <p class="text-[16px] text-dark">{elderly.notes}</p>
        </div>
      )}
    </section>

    {checkins && checkins.length > 0 && (
      <section class="flex flex-col gap-4">
        <div class="flex items-center gap-2.5">
          <Clock weight="fill" class="size-5 text-brand" />
          <h2 class="text-[20px] font-semibold text-dark">Riwayat Sapaan</h2>
        </div>

        <div class="flex flex-col gap-2.5">
          {checkins.map((c) => (
            <div class="rounded-2xl bg-light-darker px-5 py-3.5 flex items-center justify-between">
              <p class="text-[14px] text-dark/70">{c.sessionDate}</p>
              <span class="text-[13px] font-medium text-dark/50 capitalize">{c.status}</span>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>