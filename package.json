{
  "name": "kabarin",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check": "turbo check",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:bot": "bun run --cwd apps/bot dev",
    "start:bot": "bun run --cwd apps/bot start",
    "deploy:api": "bun run --cwd apps/api deploy",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:push": "bun run --cwd packages/db push",
    "db:seed": "bun run --cwd packages/db seed",
    "db:studio": "bun run --cwd packages/db studio"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@types/node": "^22.0.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "wrangler": "^4.124.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "phosphor-svelte": "^3.1.0"
  }
}
